# Deutsche Texte für die Anzeige-Bausteine von pdf.js (Fluent-Format).
# Enthält nur die Meldungen, die in Blattwerk sichtbar werden können. Fehlende IDs fallen auf Englisch zurück.

pdfjs-page-landmark =
    .aria-label = Seite { $page }
pdfjs-rendering-error = Beim Darstellen der Seite ist ein Fehler aufgetreten.
pdfjs-annotation-date-time-string = { DATETIME($dateObj, dateStyle: "short", timeStyle: "medium") }
pdfjs-text-annotation-type =
    .alt = [Anmerkung: { $type }]
pdfjs-loading-error = Beim Laden des PDFs ist ein Fehler aufgetreten.
pdfjs-invalid-file-error = Ungültige oder beschädigte PDF-Datei.
pdfjs-missing-file-error = Die PDF-Datei fehlt.
pdfjs-password-label = Gib das Kennwort ein, um diese PDF-Datei zu öffnen.
pdfjs-password-invalid = Falsches Kennwort. Bitte versuche es erneut.
pdfjs-password-ok-button = OK
pdfjs-password-cancel-button = Abbrechen
pdfjs-web-fonts-disabled = Web-Schriftarten sind deaktiviert: Eingebettete PDF-Schriftarten können nicht verwendet werden.
pdfjs-additional-layers = Zusätzliche Ebenen
