{
  "name": "blattwerk",
  "productName": "Blattwerk",
  "version": "0.5.3",
  "description": "PDF-Editor für macOS und Windows",
  "author": "Linus",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "fixtures": "node scripts/generate-fixtures.ts",
    "licenses": "node scripts/check-licenses.mjs",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --x64",
    "dist:mac:local": "npm run build && node scripts/dist-mac-local.mjs",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@embedpdf/pdfium": "2.15.1",
    "@tanstack/react-virtual": "3.14.15",
    "i18next": "26.4.4",
    "lucide-react": "1.55.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@cantoo/fontkit": "2.0.12",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/emscripten": "1.41.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
